{
  "sprint": "024.1",
  "date": "2026-10-21",
  "status": "Implemented by Codex — awaiting actual player verification.",
  "rootCauses": {
    "shop": "The live active Android profile overrode the global campaign scene list with only Warehouse_Testbed. The on-disk global list already began MainMenu/Demo. Editor Play also used the previously open Testbed.",
    "exit": "Warehouse_Testbed.Checkpoint_Exit is a respawn-only CheckpointMarker, with no WarehouseMission/MissionTrigger/results bridge. It cannot complete a mission. The real mission exit in Warehouse_Demo is a trigger at (25,1), size (1.5,3), layer 2; player is layer 2 and that collision pair is enabled.",
    "additionalFeedback": "Mission exit feedback previously expired and the Exit Stay callback skipped locked stages, including potential initial edge-contact retries."
  },
  "fixes": [
    "Persist active Android profile overrideGlobalScenes=false; synchronize its cached scene list with MainMenu/Demo/Mission01/SampleScene entries.",
    "Editor menu AKUMU 2/Play Campaign (Main Menu) explicitly opens MainMenu before entering Play Mode.",
    "Testbed HUD explicitly says development-only, no shop/results, respawn markers only, and points to MainMenu/campaign command.",
    "Mission exit displays a persistent stage-specific requirement while overlapping. Stay callbacks can retry initial boundary overlaps; blocked-exit notification emitted once per cached zone rather than every physics step.",
    "No second exit, no replacement mission system, and no movement/combat/AI balance changes."
  ],
  "modifiedFiles": [
    "Assets/Settings/Build Profiles/Android™.asset",
    "Assets/Editor/CampaignEntry.cs",
    "Assets/Editor/CampaignEntry.cs.meta",
    "Assets/Scripts/Missions/WarehouseMission.cs",
    "Assets/Scripts/Missions/MissionTrigger.cs",
    "Assets/UI/WarehouseControls.uxml",
    "Assets/Tests/EditMode/Sprint024ProgressTests.cs",
    "Assets/Tests/PlayMode/Sprint024FlowTests.cs",
    "DEVELOPMENT_LOG.md",
    "TestResults/Sprint024.json",
    "TestResults/Sprint0241.json"
  ],
  "coverageGapsClosed": "Old real-menu test invoked EnterZone directly for the exit, bypassing physical crossing; test coverage did not exercise Testbed/build-profile startup routing. New profile validation and two repeated physical-loop tests cover these integration boundaries.",
  "automatedFullLoop": {
    "sequence": "MainMenu → Play → Levels → Prepare → Shop → Start → Warehouse_Demo → physical Exit → Results → Levels → Shop → second mission → physical Exit → Results → Levels",
    "runsPerTest": 2,
    "variants": [
      "No purchases",
      "UI buys/equips pistol ($35), compatible reserve ($8) and armor ($30)"
    ],
    "purchaseChecks": "Starting QA funds 100; after purchases 27; pistol ownership/selected primary/reserve48/armor60 persist through both mission scenes and disk save reload.",
    "physicalChecks": "Actual PlayerActions.SetTouchMove drives Rigidbody2D from x23.1 through Mission_Exit. No direct EnterZone invocation for exit. A real non-player enemy rigidbody at the exit does not complete it. Locked exit remains visible for >4 seconds. Continued physics contact cannot duplicate results/rewards.",
    "controlledSetup": "Combat defeats and intermediate objective-zone setup use controlled calls/positions; records recovered through INTERACT UI. This is not a natural combat/whole-level traversal playthrough.",
    "saveIsolation": "GUID-named OS temporary profiles in test fixture; no fake test funds assigned to user's real save."
  },
