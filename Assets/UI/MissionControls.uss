.mission-card { position: absolute; left: 18px; top: 14px; max-width: 61%; padding: 12px 16px; background-color: rgba(9,15,26,0.92); color: rgb(235,240,240); white-space: normal; }
.mission-heading { color: rgb(185,204,210); font-size: 17px; -unity-font-style: bold; }
.mission-objective { color: rgb(255,221,137); font-size: 21px; -unity-font-style: bold; white-space: normal; margin-top: 5px; }
.mission-notice { font-size: 18px; white-space: normal; margin-top: 8px; }
.mission-time { color: rgb(175,187,193); font-size: 15px; margin-top: 5px; }
.interaction-prompt { align-self: center; margin-top: 26%; color: rgb(255,231,169); background-color: rgba(9,15,26,0.88); font-size: 21px; }
.interact-button { position: absolute; left: 42%; bottom: 90px; padding: 14px 25px; font-size: 21px; background-color: rgb(43,71,78); color: white; border-width: 2px; border-color: rgb(255,221,137); }
.results { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(6,11,18,0.95); }
.results-card { width: 76%; max-width: 640px; padding: 28px; background-color: rgb(20,30,39); border-width: 2px; border-color: rgb(103,132,145); color: rgb(240,244,244); }
.results-heading { color: rgb(255,221,137); font-size: 34px; -unity-font-style: bold; }
.results-title { font-size: 25px; margin-top: 6px; }
.results-stats { font-size: 23px; margin-top: 24px; margin-bottom: 24px; white-space: normal; }
.results-replay { padding: 14px; background-color: rgb(43,83,91); color: white; font-size: 24px; }
.results-note { margin-top: 14px; font-size: 17px; white-space: normal; color: rgb(176,189,195); }
.mission-complete .equipment, .mission-complete .stick, .mission-complete .action, .mission-complete .mission-card, .mission-complete .interact-button, .mission-complete .interaction-prompt { display: none; }
.hidden { display: none; }
